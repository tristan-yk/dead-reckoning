# =========================================================
# KiCad
# =========================================================
# Adapted from:
# https://github.com/github/gitignore/blob/master/KiCad.gitignore

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
/build

# Netlist files
*.net

# Autorouter files
*.dsn
*.ses

# Footprint association
*.cmp

# Exported BOM files
*.xml
*.csv
*.tsv

# Misc
*.log
*.raw
.svg2shenzhen-cache

# =========================================================
# MATLAB / Simulink
# =========================================================

# Autosave / backup
*.asv
*.autosave
*.slxc
*.slx.autosave
*.mdl.autosave

# Simulink cache
slprj/
simulink_cache/
*.slxc

# MATLAB code generation
codegen/
# ...but Simulation/Codegen is a hand-authored MATLAB Coder project, not generated
# output. It is only caught by the rule above because Windows matches ignore
# patterns case-insensitively. Un-ignore the folder; its nested codegen/ output
# directory is still covered by the rule above.
!Simulation/Codegen/

# The generated firmware sources for filter_entry ARE tracked, so firmware can be
# built without running MATLAB Coder. Everything else Coder emits (build-info
# .mat files, the HTML report, the MEX interface glue, the example main) stays
# out. Re-include the directory chain first: git will not descend into an
# ignored directory, so a negation deeper down would never be reached.
!Simulation/Codegen/codegen/
!Simulation/Codegen/codegen/lib/
!Simulation/Codegen/codegen/lib/filter_entry/
Simulation/Codegen/codegen/lib/filter_entry/*
!Simulation/Codegen/codegen/lib/filter_entry/*.c
!Simulation/Codegen/codegen/lib/filter_entry/*.h
*_ert_rtw/
*_grt_rtw/
*_rtw/
*_tlc/
rtw/

# Simulink build artifacts
*.rtw
*.rti
*.tmf
*.mex*
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# MATLAB preferences and local configs
prefdir/
*.prf

# MATLAB path definition
pathdef.m

# Simulink project cache
resources/project/
*.autosave

# MATLAB editor temp files
*.m~ 

# Parallel computing toolbox
*.matlabpool

# MATLAB test artifacts
testresults/
testoutput/

# =========================================================
# Simulation outputs (optional)
# =========================================================

# Large simulation data
*.mat
*.hdf5

# Coverage / logging
*.cvt
*.cov

# =========================================================
# OS / editor junk
# =========================================================

.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/